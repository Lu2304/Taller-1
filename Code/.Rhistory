stargazer(GEIH_BOG_01[des_vars], type = "text")
colnames((GEIH_BOG_01))
unique(GEIH_BOG_01$totalHoursWorked)
des_vars <- c("age", "y_total_m", "totalHoursWorked")
stargazer(GEIH_BOG_01[des_vars], type = "text")
des_vars[!des_vars %in% names(GEIH_BOG_01)]
sapply(GEIH_BOG_01[des_vars], class)
nrow(GEIH_BOG_01[, des_vars])
stargazer(as.data.frame(GEIH_BOG_01[, des_vars]), type = "text")
